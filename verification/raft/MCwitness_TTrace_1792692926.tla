---- MODULE MCwitness_TTrace_1792692926 ----
EXTENDS Sequences, TLCExt, Toolbox, Naturals, TLC, MCwitness

_expression ==
    LET MCwitness_TEExpression == INSTANCE MCwitness_TEExpression
    IN MCwitness_TEExpression!expression
----

_trace ==
    LET MCwitness_TETrace == INSTANCE MCwitness_TETrace
    IN MCwitness_TETrace!trace
----

_inv ==
    ~(
        TLCGet("level") = Len(_TETrace)
        /\
        votedFor = ((s1 :> s1 @@ s2 :> s1 @@ s3 :> 0 @@ s4 :> 0))
        /\
        log = ((s1 :> <<[value |-> [newconf |-> {s1}, learners |-> {}], term |-> 1, type |-> "ConfigEntry"], [value |-> [newconf |-> {s1, s2}, learners |-> {}], term |-> 1, type |-> "ConfigEntry"], [value |-> [newconf |-> {s1, s2, s3}, learners |-> {}], term |-> 1, type |-> "ConfigEntry"], [value |-> [newconf |-> {s1, s2, s3, s4}, learners |-> {}], term |-> 2, type |-> "ConfigEntry"]>> @@ s2 :> <<[value |-> [newconf |-> {s1}, learners |-> {}], term |-> 1, type |-> "ConfigEntry"], [value |-> [newconf |-> {s1, s2}, learners |-> {}], term |-> 1, type |-> "ConfigEntry"], [value |-> [newconf |-> {s1, s2, s3}, learners |-> {}], term |-> 1, type |-> "ConfigEntry"], [value |-> [newconf |-> {s1, s2, s3, s4}, learners |-> {}], term |-> 2, type |-> "ConfigEntry"]>> @@ s3 :> <<[value |-> [newconf |-> {s1}, learners |-> {}], term |-> 1, type |-> "ConfigEntry"], [value |-> [newconf |-> {s1, s2}, learners |-> {}], term |-> 1, type |-> "ConfigEntry"], [value |-> [newconf |-> {s1, s2, s3}, learners |-> {}], term |-> 1, type |-> "ConfigEntry"]>> @@ s4 :> <<>>))
        /\
        pendingMessages = (<<>>)
        /\
        pendingConfChangeIndex = ((s1 :> 4 @@ s2 :> 0 @@ s3 :> 0 @@ s4 :> 0))
        /\
        currentTerm = ((s1 :> 2 @@ s2 :> 2 @@ s3 :> 1 @@ s4 :> 0))
        /\
        votesResponded = ((s1 :> {s1, s2} @@ s2 :> {} @@ s3 :> {} @@ s4 :> {}))
        /\
        durableState = ((s1 :> [currentTerm |-> 2, votedFor |-> s1, log |-> 4, commitIndex |-> 3, config |-> [learners |-> {}, jointConfig |-> <<{s1, s2, s3}, {}>>]] @@ s2 :> [currentTerm |-> 2, votedFor |-> s1, log |-> 4, commitIndex |-> 3, config |-> [learners |-> {}, jointConfig |-> <<{s1, s2, s3}, {}>>]] @@ s3 :> [currentTerm |-> 1, votedFor |-> 0, log |-> 3, commitIndex |-> 3, config |-> [learners |-> {}, jointConfig |-> <<{s1, s2, s3}, {}>>]] @@ s4 :> [currentTerm |-> 0, votedFor |-> 0, log |-> 0, commitIndex |-> 0, config |-> [learners |-> {}, jointConfig |-> <<{}, {}>>]]))
        /\
        votesGranted = ((s1 :> {s1, s2} @@ s2 :> {} @@ s3 :> {} @@ s4 :> {}))
        /\
        reconfigCount = (0)
        /\
        matchIndex = ((s1 :> (s1 :> 4 @@ s2 :> 0 @@ s3 :> 0 @@ s4 :> 0) @@ s2 :> (s1 :> 0 @@ s2 :> 0 @@ s3 :> 0 @@ s4 :> 0) @@ s3 :> (s1 :> 0 @@ s2 :> 0 @@ s3 :> 0 @@ s4 :> 0) @@ s4 :> (s1 :> 0 @@ s2 :> 0 @@ s3 :> 0 @@ s4 :> 0)))
        /\
        messages = (([mtype |-> "AppendEntriesRequest", msource |-> s1, mdest |-> s2, mterm |-> 2, msubtype |-> "app", mprevLogIndex |-> 3, mprevLogTerm |-> 1, mentries |-> <<[value |-> [newconf |-> {s1, s2, s3, s4}, learners |-> {}], term |-> 2, type |-> "ConfigEntry"]>>, mcommitIndex |-> 3] :> 1))
        /\
        step = (18)
        /\
        state = ((s1 :> "Leader" @@ s2 :> "Follower" @@ s3 :> "Follower" @@ s4 :> "Follower"))
        /\
        config = ((s1 :> [learners |-> {}, jointConfig |-> <<{s1, s2, s3}, {}>>] @@ s2 :> [learners |-> {}, jointConfig |-> <<{s1, s2, s3}, {}>>] @@ s3 :> [learners |-> {}, jointConfig |-> <<{s1, s2, s3}, {}>>] @@ s4 :> [learners |-> {}, jointConfig |-> <<{}, {}>>]))
        /\
        commitIndex = ((s1 :> 3 @@ s2 :> 3 @@ s3 :> 3 @@ s4 :> 0))
    )
----

_init ==
    /\ pendingMessages = _TETrace[1].pendingMessages
    /\ reconfigCount = _TETrace[1].reconfigCount
    /\ votesResponded = _TETrace[1].votesResponded
    /\ state = _TETrace[1].state
    /\ config = _TETrace[1].config
    /\ matchIndex = _TETrace[1].matchIndex
    /\ votedFor = _TETrace[1].votedFor
    /\ durableState = _TETrace[1].durableState
    /\ commitIndex = _TETrace[1].commitIndex
    /\ step = _TETrace[1].step
    /\ messages = _TETrace[1].messages
    /\ currentTerm = _TETrace[1].currentTerm
    /\ log = _TETrace[1].log
    /\ votesGranted = _TETrace[1].votesGranted
    /\ pendingConfChangeIndex = _TETrace[1].pendingConfChangeIndex
----

_next ==
    /\ \E i,j \in DOMAIN _TETrace:
        /\ \/ /\ j = i + 1
              /\ i = TLCGet("level")
        /\ pendingMessages  = _TETrace[i].pendingMessages
        /\ pendingMessages' = _TETrace[j].pendingMessages
        /\ reconfigCount  = _TETrace[i].reconfigCount
        /\ reconfigCount' = _TETrace[j].reconfigCount
        /\ votesResponded  = _TETrace[i].votesResponded
        /\ votesResponded' = _TETrace[j].votesResponded
        /\ state  = _TETrace[i].state
        /\ state' = _TETrace[j].state
        /\ config  = _TETrace[i].config
        /\ config' = _TETrace[j].config
        /\ matchIndex  = _TETrace[i].matchIndex
        /\ matchIndex' = _TETrace[j].matchIndex
        /\ votedFor  = _TETrace[i].votedFor
        /\ votedFor' = _TETrace[j].votedFor
        /\ durableState  = _TETrace[i].durableState
        /\ durableState' = _TETrace[j].durableState
        /\ commitIndex  = _TETrace[i].commitIndex
        /\ commitIndex' = _TETrace[j].commitIndex
        /\ step  = _TETrace[i].step
        /\ step' = _TETrace[j].step
        /\ messages  = _TETrace[i].messages
        /\ messages' = _TETrace[j].messages
        /\ currentTerm  = _TETrace[i].currentTerm
        /\ currentTerm' = _TETrace[j].currentTerm
        /\ log  = _TETrace[i].log
        /\ log' = _TETrace[j].log
        /\ votesGranted  = _TETrace[i].votesGranted
        /\ votesGranted' = _TETrace[j].votesGranted
        /\ pendingConfChangeIndex  = _TETrace[i].pendingConfChangeIndex
        /\ pendingConfChangeIndex' = _TETrace[j].pendingConfChangeIndex

\* Uncomment the ASSUME below to write the states of the error trace
\* to the given file in Json format. Note that you can pass any tuple
\* to `JsonSerialize`. For example, a sub-sequence of _TETrace.
    \* ASSUME
    \*     LET J == INSTANCE Json
    \*         IN J!JsonSerialize("MCwitness_TTrace_1792692926.json", _TETrace)

=============================================================================

 Note that you can extract this module `MCwitness_TEExpression`
  to a dedicated file to reuse `expression` (the module in the 
  dedicated `MCwitness_TEExpression.tla` file takes precedence 
  over the module `MCwitness_TEExpression` below).

---- MODULE MCwitness_TEExpression ----
EXTENDS Sequences, TLCExt, Toolbox, Naturals, TLC, MCwitness

expression == 
    [
        \* To hide variables of the `MCwitness` spec from the error trace,
        \* remove the variables below.  The trace will be written in the order
        \* of the fields of this record.
        pendingMessages |-> pendingMessages
        ,reconfigCount |-> reconfigCount
        ,votesResponded |-> votesResponded
        ,state |-> state
        ,config |-> config
        ,matchIndex |-> matchIndex
        ,votedFor |-> votedFor
        ,durableState |-> durableState
        ,commitIndex |-> commitIndex
        ,step |-> step
        ,messages |-> messages
        ,currentTerm |-> currentTerm
        ,log |-> log
        ,votesGranted |-> votesGranted
        ,pendingConfChangeIndex |-> pendingConfChangeIndex
        
        \* Put additional constant-, state-, and action-level expressions here:
        \* ,_stateNumber |-> _TEPosition
        \* ,_pendingMessagesUnchanged |-> pendingMessages = pendingMessages'
        
        \* Format the `pendingMessages` variable as Json value.
        \* ,_pendingMessagesJson |->
        \*     LET J == INSTANCE Json
        \*     IN J!ToJson(pendingMessages)
        
        \* Lastly, you may build expressions over arbitrary sets of states by
        \* leveraging the _TETrace operator.  For example, this is how to
        \* count the number of times a spec variable changed up to the current
        \* state in the trace.
        \* ,_pendingMessagesModCount |->
        \*     LET F[s \in DOMAIN _TETrace] ==
        \*         IF s = 1 THEN 0
        \*         ELSE IF _TETrace[s].pendingMessages # _TETrace[s-1].pendingMessages
        \*             THEN 1 + F[s-1] ELSE F[s-1]
        \*     IN F[_TEPosition - 1]
    ]

=============================================================================



Parsing and semantic processing can take forever if the trace below is long.
 In this case, it is advised to uncomment the module below to deserialize the
 trace from a generated binary file.

\*
\*---- MODULE MCwitness_TETrace ----
\*EXTENDS IOUtils, TLC, MCwitness
\*
\*trace == IODeserialize("MCwitness_TTrace_1792692926.bin", TRUE)
\*
\*=============================================================================
\*

