From 4cb1c638574e6a9c7de24d9ae8d09476278b31a4 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Fri, 23 Oct 2026 17:22:53 +0000
Subject: [PATCH] tla: align membership handling with the implementation

Differences between etcdraft.tla and the code, found while checking
membership changes. Some made the spec stricter than the code, others more
permissive:

- AddNewServer kept a promoted learner in the learner set; makeVoter
  removes it.
- RequestVote also asked learners; campaign asks only voters.
- BecomeLeader required every granted vote to come from a voter, so one
  vote from a non-voter blocked the election; TallyVotes ignores
  non-voters.
- ApplySimpleConfChange cleared the pending conf change marker when it was
  at least the applied index, and re-applying an older committed config is
  always enabled, so a leader could stack two uncommitted config entries.
  The code refuses a change while pendingConfIndex > applied, and
  becomeLeader sets pendingConfIndex to the last index.
- Timeout did not model hup's refusal to campaign with committed but
  unapplied conf changes.
- A follower appended in one step and updated its commit index and
  replied in a later one; handleAppendEntries does all three at once.

With the last two as they were, the spec can elect two leaders in one term
(initial config {1,2,3}, add 4, then remove 3; node 3 has both entries,
does not know the first is committed, and campaigns on the old config).
The behavior disappears only when both are modeled as the code does.

The last three are modeled behind the constants LeaderPendingAtElection,
CampaignRequiresAppliedConfig and AtomicAppendCommit, set TRUE in the
configs; FALSE keeps the earlier behavior.

Traceetcdraft.tla: newRaft logs InitState before loadState, so a
restart's InitState line shows term 0, commit 0 and an empty config, and
RestartIfLogged could not match a real restart. The restored state is now
checked at the BecomeFollower line that follows.

Also add membership invariants (LearnersVotersDisjointInv,
ConfigEntryDisjointInv, KnowsPrevConfigCommittedInv,
AtMostOneUncommittedConfigInv) to MCetcdraft.cfg.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 tla/MCetcdraft.cfg    |   9 +++
 tla/Traceetcdraft.cfg |   5 ++
 tla/Traceetcdraft.tla |  27 ++++++++-
 tla/etcdraft.cfg      |   5 ++
 tla/etcdraft.tla      | 132 +++++++++++++++++++++++++++++++++++++++---
 5 files changed, 168 insertions(+), 10 deletions(-)

diff --git a/tla/MCetcdraft.cfg b/tla/MCetcdraft.cfg
index 31ad958..243628f 100644
--- a/tla/MCetcdraft.cfg
+++ b/tla/MCetcdraft.cfg
@@ -15,6 +15,11 @@
 SPECIFICATION mc_etcdSpec
 
 CONSTANTS
+    \* TRUE models the code; see etcdraft.tla.
+    CampaignRequiresAppliedConfig = TRUE
+    AtomicAppendCommit = TRUE
+    LeaderPendingAtElection = TRUE
+
     s1 = 1
     s2 = 2
     s3 = 3
@@ -59,6 +64,10 @@ CHECK_DEADLOCK
     FALSE
 
 INVARIANTS
+    LearnersVotersDisjointInv
+    ConfigEntryDisjointInv
+    KnowsPrevConfigCommittedInv
+    AtMostOneUncommittedConfigInv
     LogInv
     MoreThanOneLeaderInv
     ElectionSafetyInv
diff --git a/tla/Traceetcdraft.cfg b/tla/Traceetcdraft.cfg
index 36e6c8a..d765e29 100644
--- a/tla/Traceetcdraft.cfg
+++ b/tla/Traceetcdraft.cfg
@@ -44,6 +44,11 @@ CHECK_DEADLOCK
     FALSE
 
 CONSTANTS
+    \* TRUE models the code; see etcdraft.tla.
+    CampaignRequiresAppliedConfig = TRUE
+    AtomicAppendCommit = TRUE
+    LeaderPendingAtElection = TRUE
+
     Nil         = "0"
     
     ValueEntry  = "ValueEntry"
diff --git a/tla/Traceetcdraft.tla b/tla/Traceetcdraft.tla
index ccbae2d..73fdd98 100644
--- a/tla/Traceetcdraft.tla
+++ b/tla/Traceetcdraft.tla
@@ -358,10 +358,33 @@ ReadyIfLogged(i) ==
     /\ LoglineIsNodeEvent("Ready", i)
     /\ Ready(i)
 
+\* raft.go newRaft logs InitState *before* loadState, so on a restart the
+\* InitState line shows term 0, commit 0 and an empty config, which no real
+\* restart matches. The restart is therefore not validated at InitState; the
+\* restored state is checked at the BecomeFollower line that newRaft logs
+\* after loading it (RestartBecomeFollowerIfLogged).
 RestartIfLogged(i) ==
     /\ LoglineIsNodeEvent("InitState", i)
     /\ Restart(i)
-    /\ ValidatePostStates(i)
+
+\* The previous line for node i, before the current one.
+PrevNodeLine(i) ==
+    LET k == SelectLastInSubSeq(TraceLog, 1, l-1, LAMBDA x: x.event.nid = i)
+    IN IF k > 0 THEN TraceLog[k] ELSE logline
+
+\* The BecomeFollower that newRaft logs right after a restart
+\* (preceded by InitState and the restored-config ApplyConfChange). The
+\* spec's Restart already restored the state; check it matches.
+RestartBecomeFollowerIfLogged(i) ==
+    /\ LoglineIsNodeEvent("BecomeFollower", i)
+    /\ PrevNodeLine(i).event.name \in {"InitState", "ApplyConfChange"}
+    /\ state[i] = Follower
+    /\ currentTerm[i] = logline.event.state.term
+    /\ votedFor[i] = logline.event.state.vote
+    /\ Len(log[i]) = logline.event.log
+    /\ commitIndex[i] = logline.event.state.commit
+    /\ config[i].jointConfig = ConfFromLog(logline)
+    /\ UNCHANGED <<vars>>
 
 LoglineIsBecomeFollowerInUpdateTermOrReturnToFollower ==
     /\ LoglineIsEvent("BecomeFollower")
@@ -426,6 +449,8 @@ TraceNextNonReceiveActions ==
           /\ \E i \in Server: RestartIfLogged(i)
        \/ /\ LoglineIsEvent("BecomeFollower")
           /\ \E i \in Server: StepDownToFollowerIfLogged(i)
+       \/ /\ LoglineIsEvent("BecomeFollower")
+          /\ \E i \in Server: RestartBecomeFollowerIfLogged(i)
        \/ SkipUnusedLogline
     /\ StepToNextTrace
     
diff --git a/tla/etcdraft.cfg b/tla/etcdraft.cfg
index ae73138..3e58109 100644
--- a/tla/etcdraft.cfg
+++ b/tla/etcdraft.cfg
@@ -14,6 +14,11 @@
 \*
 
 CONSTANTS
+    \* TRUE models the code; see etcdraft.tla.
+    CampaignRequiresAppliedConfig = TRUE
+    AtomicAppendCommit = TRUE
+    LeaderPendingAtElection = TRUE
+
     s1 = 1
     s2 = 2
     s3 = 3
diff --git a/tla/etcdraft.tla b/tla/etcdraft.tla
index 7828474..b2353fd 100644
--- a/tla/etcdraft.tla
+++ b/tla/etcdraft.tla
@@ -287,10 +287,44 @@ Restart(i) ==
     /\ config' = [config EXCEPT ![i] = durableState[i].config]
     /\ UNCHANGED <<messages, durableState, reconfigCount>>
 
+\* Campaign guard. TRUE models the code; FALSE keeps the earlier, more
+\* permissive behavior of this spec.
+\* raft.go hup(): a node with committed but unapplied conf changes does not
+\* campaign. The spec has no applied index, so "unapplied" is approximated as
+\* "current config differs from the latest committed config entry".
+CONSTANT CampaignRequiresAppliedConfig
+ASSUME CampaignRequiresAppliedConfig \in BOOLEAN
+
+\* See NoConflictAppendEntriesRequest. TRUE models the code; FALSE keeps the
+\* earlier behavior of this spec.
+CONSTANT AtomicAppendCommit
+ASSUME AtomicAppendCommit \in BOOLEAN
+
+\* Pending conf change rule. TRUE models the code; FALSE keeps the earlier
+\* behavior of this spec.
+\* raft.go becomeLeader sets pendingConfIndex = lastIndex, and a conf change
+\* is accepted only if pendingConfIndex <= applied. The spec has no applied
+\* index; "applied" is over-approximated by commitIndex plus "no committed
+\* but unapplied config entry", which admits every behavior the code does.
+CONSTANT LeaderPendingAtElection
+ASSUME LeaderPendingAtElection \in BOOLEAN
+
+HasUnappliedCommittedConfig(i) ==
+    LET k == SelectLastInSubSeq(log[i], 1, commitIndex[i], LAMBDA x: x.type = ConfigEntry)
+    IN /\ k > 0
+       /\ config[i] # [jointConfig |-> << log[i][k].value.newconf, {} >>, learners |-> log[i][k].value.learners]
+
+\* May leader i append a new config entry?
+CanProposeConf(i) ==
+    IF LeaderPendingAtElection
+    THEN pendingConfChangeIndex[i] <= commitIndex[i] /\ ~HasUnappliedCommittedConfig(i)
+    ELSE pendingConfChangeIndex[i] = 0
+
 \* Server i times out and starts a new election.
 \* @type: Int => Bool;
 Timeout(i) == /\ state[i] \in {Follower, Candidate}
               /\ i \in GetConfig(i)
+              /\ CampaignRequiresAppliedConfig => ~HasUnappliedCommittedConfig(i)
               /\ state' = [state EXCEPT ![i] = Candidate]
               /\ currentTerm' = [currentTerm EXCEPT ![i] = currentTerm[i] + 1]
               /\ votedFor' = [votedFor EXCEPT ![i] = i]
@@ -302,7 +336,9 @@ Timeout(i) == /\ state[i] \in {Follower, Candidate}
 \* @type: (Int, Int) => Bool;
 RequestVote(i, j) ==
     /\ state[i] = Candidate
-    /\ j \in ((GetConfig(i) \union GetLearners(i)) \ votesResponded[i])
+    \* The code sends MsgVote only to voters (raft.go campaign:
+    \* r.trk.Voters.IDs()); this spec used to ask learners too.
+    /\ j \in (GetConfig(i) \ votesResponded[i])
     /\ IF i # j 
         THEN Send([mtype            |-> RequestVoteRequest,
                    mterm            |-> currentTerm[i],
@@ -374,11 +410,18 @@ SendSnapshot(i, j, index) ==
 \* @type: Int => Bool;
 BecomeLeader(i) ==
     /\ state[i] = Candidate
-    /\ votesGranted[i] \in Quorum(GetConfig(i))
+    \* The code tallies only voters (tracker.TallyVotes skips learners and
+    \* non-members). This spec used to require every granted vote to
+    \* come from a voter, so a single stray vote blocked the election.
+    /\ (votesGranted[i] \cap GetConfig(i)) \in Quorum(GetConfig(i))
     /\ state'      = [state EXCEPT ![i] = Leader]
     /\ matchIndex' = [matchIndex EXCEPT ![i] =
                          [j \in Server |-> IF j = i THEN Len(log[i]) ELSE 0]]
-    /\ UNCHANGED <<messageVars, currentTerm, votedFor, pendingConfChangeIndex, candidateVars, logVars, configVars, durableState>>
+    \* See LeaderPendingAtElection.
+    /\ pendingConfChangeIndex' = IF LeaderPendingAtElection
+                                 THEN [pendingConfChangeIndex EXCEPT ![i] = Len(log[i])]
+                                 ELSE pendingConfChangeIndex
+    /\ UNCHANGED <<messageVars, currentTerm, votedFor, candidateVars, logVars, configVars, durableState>>
     
 Replicate(i, v, t) == 
     /\ t \in {ValueEntry, ConfigEntry}
@@ -427,8 +470,10 @@ AddNewServer(i, j) ==
     /\ state[i] = Leader
     /\ j \notin GetConfig(i)
     /\ ~IsJointConfig(i)
-    /\ IF pendingConfChangeIndex[i] = 0 THEN
-            /\ Replicate(i, [newconf |-> GetConfig(i) \union {j}, learners |-> GetLearners(i)], ConfigEntry)
+    /\ IF CanProposeConf(i) THEN
+            \* Promoting a learner removes it from the learner set
+            \* (confchange.go makeVoter); this spec used to keep it in both sets.
+            /\ Replicate(i, [newconf |-> GetConfig(i) \union {j}, learners |-> GetLearners(i) \ {j}], ConfigEntry)
             /\ pendingConfChangeIndex' = [pendingConfChangeIndex EXCEPT ![i]=Len(log'[i])]
        ELSE 
             /\ Replicate(i, <<>>, ValueEntry)
@@ -440,7 +485,7 @@ AddLearner(i, j) ==
     /\ state[i] = Leader
     /\ j \notin GetConfig(i) \union GetLearners(i)
     /\ ~IsJointConfig(i)
-    /\ IF pendingConfChangeIndex[i] = 0 THEN 
+    /\ IF CanProposeConf(i) THEN 
             /\ Replicate(i, [newconf |-> GetConfig(i), learners |-> GetLearners(i) \union {j}], ConfigEntry)
             /\ pendingConfChangeIndex' = [pendingConfChangeIndex EXCEPT ![i]=Len(log'[i])]
        ELSE 
@@ -453,7 +498,7 @@ DeleteServer(i, j) ==
     /\ state[i] = Leader
     /\ j \in GetConfig(i) \union GetLearners(i)
     /\ ~IsJointConfig(i)
-    /\ IF pendingConfChangeIndex[i] = 0 THEN
+    /\ IF CanProposeConf(i) THEN
             /\ Replicate(i, [newconf |-> GetConfig(i) \ {j}, learners |-> GetLearners(i) \ {j}], ConfigEntry)
             /\ pendingConfChangeIndex' = [pendingConfChangeIndex EXCEPT ![i]=Len(log'[i])]
        ELSE 
@@ -468,7 +513,18 @@ ApplySimpleConfChange(i) ==
             /\ k > 0
             /\ k <= commitIndex[i]
             /\ config' = ApplyConfigUpdate(i, k)
-            /\ IF state[i] = Leader /\ pendingConfChangeIndex[i] >= k THEN 
+            \* Without LeaderPendingAtElection, the marker is cleared when it is
+            \* >= the applied index k, and re-applying an old committed config
+            \* is always enabled, so a leader can clear it at will and stack a
+            \* second uncommitted config entry. The code allows a new change only
+            \* once applied >= pendingConfIndex (CanProposeConf), so with LeaderPendingAtElection
+            \* the marker is left alone and only the leader's own change counts.
+            /\ IF LeaderPendingAtElection
+               THEN /\ IF state[i] = Leader /\ k = pendingConfChangeIndex[i] /\ config[i] # config'[i]
+                       THEN reconfigCount' = reconfigCount + 1
+                       ELSE UNCHANGED reconfigCount
+                    /\ UNCHANGED pendingConfChangeIndex
+               ELSE IF state[i] = Leader /\ pendingConfChangeIndex[i] >= k THEN 
                 /\ reconfigCount' = reconfigCount + 1
                 /\ pendingConfChangeIndex' = [pendingConfChangeIndex EXCEPT ![i] = 0]
                ELSE UNCHANGED <<reconfigCount, pendingConfChangeIndex>>
@@ -597,7 +653,24 @@ NoConflictAppendEntriesRequest(i, index, m) ==
     /\ index > commitIndex[i]
     /\ HasNoConflict(i, index, m.mentries)
     /\ log' = [log EXCEPT ![i] = @ \o SubSeq(m.mentries, Len(@)-index+2, Len(m.mentries))]
-    /\ UNCHANGED <<messageVars, serverVars, commitIndex, durableState>>
+    \* The code appends, learns the commit index and replies in one
+    \* step (raft.go handleAppendEntries -> raftLog.maybeAppend:
+    \* commitTo(min(m.Commit, lastnewi)), then MsgAppResp{Index: lastnewi}).
+    \* Without AtomicAppendCommit, the follower appends here and commits + replies in a later step
+    \* (AppendEntriesAlreadyDone), which can also reply with the commit
+    \* index instead of the last new index.
+    /\ IF AtomicAppendCommit
+       THEN /\ CommitTo(i, Min({m.mcommitIndex, m.mprevLogIndex + Len(m.mentries)}))
+            /\ Reply([mtype           |-> AppendEntriesResponse,
+                      msubtype        |-> m.msubtype,
+                      mterm           |-> currentTerm[i],
+                      msuccess        |-> TRUE,
+                      mmatchIndex     |-> m.mprevLogIndex + Len(m.mentries),
+                      msource         |-> i,
+                      mdest           |-> m.msource],
+                      m)
+            /\ UNCHANGED <<serverVars, durableState>>
+       ELSE UNCHANGED <<messageVars, serverVars, commitIndex, durableState>>
 
 \* @type: (Int, Int, Bool, AEREQT) => Bool;
 AcceptAppendEntriesRequest(i, j, logOk, m) ==
@@ -873,6 +946,36 @@ CommittedIsDurableInv ==
     \A i \in Server :
         state[i] = Leader => commitIndex[i] <= durableState[i].log
 
+\* Membership invariants.
+
+\* No server is both a voter and a learner in any server's config.
+LearnersVotersDisjointInv ==
+    \A i \in Server : GetConfig(i) \cap GetLearners(i) = {}
+
+\* A config entry's learner and voter sets are disjoint too.
+ConfigEntryDisjointInv ==
+    \A i \in Server : \A k \in 1..Len(log[i]) :
+        log[i][k].type = ConfigEntry => log[i][k].value.newconf \cap log[i][k].value.learners = {}
+
+\* A server holding a config entry knows the previous config entry is
+\* committed. With single-step changes this keeps every campaigning node's
+\* config within one step of the latest.
+KnowsPrevConfigCommittedInv ==
+    \A i \in Server :
+        LET cfgIdx == {k \in 1..Len(log[i]) : log[i][k].type = ConfigEntry}
+            last == MaxOrZero(cfgIdx)
+            prev == MaxOrZero(cfgIdx \ {last})
+        IN prev <= commitIndex[i]
+
+\* Diagnostic: a leader's log holds at most one config entry above its
+\* commit index. The code enforces this via pendingConfIndex (set to the
+\* last index on election). Without LeaderPendingAtElection the spec does
+\* not, so a violation then shows the spec exploring behaviors the code
+\* forbids.
+AtMostOneUncommittedConfigInv ==
+    \A i \in Server : state[i] = Leader =>
+        Cardinality({k \in (commitIndex[i]+1)..Len(log[i]) : log[i][k].type = ConfigEntry}) <= 1
+
 -----
 
 
@@ -882,6 +985,17 @@ CommittedIsDurableInv ==
 
 \* Changelog:
 \* 
+\* 2026-10-23:
+\* - Align membership handling with the implementation: a promoted learner
+\*   leaves the learner set, votes are requested from and counted for voters
+\*   only.
+\* - Add CampaignRequiresAppliedConfig, AtomicAppendCommit and
+\*   LeaderPendingAtElection to model three implementation rules that
+\*   election safety depends on across config changes. Unless both
+\*   CampaignRequiresAppliedConfig and AtomicAppendCommit are TRUE, the spec
+\*   can elect two leaders in one term.
+\* - Add membership invariants.
+\*
 \* 2023-11-23:
 \* - Replace configuration actions by those in etcd implementation.
 \* - Refactor spec structure to decouple core spec and model checker spec for 
-- 
2.43.0

