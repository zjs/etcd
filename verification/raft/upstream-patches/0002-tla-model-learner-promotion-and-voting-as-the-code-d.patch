From dcee8153939ba594091a5f36a9678d698be4e9e4 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 24 Oct 2026 15:52:09 +0000
Subject: [PATCH 2/7] tla: model learner promotion and voting as the code does

- AddNewServer kept a promoted learner in the learner set, so it was a
  voter and a learner at once. confchange.go makeVoter removes it from
  Learners.
- RequestVote also asked learners for votes; campaign asks only
  trk.Voters.
- BecomeLeader required every granted vote to come from a voter, so a
  single vote from a non-voter blocked the election. TallyVotes ignores
  votes from non-voters.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 tla/etcdraft.tla | 9 ++++++---
 1 file changed, 6 insertions(+), 3 deletions(-)

diff --git a/tla/etcdraft.tla b/tla/etcdraft.tla
index 4591ad9..361b21c 100644
--- a/tla/etcdraft.tla
+++ b/tla/etcdraft.tla
@@ -305,7 +305,8 @@ Timeout(i) == /\ state[i] \in {Follower, Candidate}
 \* @type: (Int, Int) => Bool;
 RequestVote(i, j) ==
     /\ state[i] = Candidate
-    /\ j \in ((GetConfig(i) \union GetLearners(i)) \ votesResponded[i])
+    \* Only voters are asked (raft.go campaign: r.trk.Voters.IDs()).
+    /\ j \in (GetConfig(i) \ votesResponded[i])
     /\ IF i # j 
         THEN Send([mtype            |-> RequestVoteRequest,
                    mterm            |-> currentTerm[i],
@@ -377,7 +378,8 @@ SendSnapshot(i, j, index) ==
 \* @type: Int => Bool;
 BecomeLeader(i) ==
     /\ state[i] = Candidate
-    /\ votesGranted[i] \in Quorum(GetConfig(i))
+    \* Only voters' votes count (tracker.TallyVotes).
+    /\ (votesGranted[i] \cap GetConfig(i)) \in Quorum(GetConfig(i))
     /\ state'      = [state EXCEPT ![i] = Leader]
     /\ matchIndex' = [matchIndex EXCEPT ![i] =
                          [j \in Server |-> IF j = i THEN Len(log[i]) ELSE 0]]
@@ -431,7 +433,8 @@ AddNewServer(i, j) ==
     /\ j \notin GetConfig(i)
     /\ ~IsJointConfig(i)
     /\ IF pendingConfChangeIndex[i] = 0 THEN
-            /\ Replicate(i, [newconf |-> GetConfig(i) \union {j}, learners |-> GetLearners(i)], ConfigEntry)
+            \* A promoted learner leaves the learner set (confchange.go makeVoter).
+            /\ Replicate(i, [newconf |-> GetConfig(i) \union {j}, learners |-> GetLearners(i) \ {j}], ConfigEntry)
             /\ pendingConfChangeIndex' = [pendingConfChangeIndex EXCEPT ![i]=Len(log'[i])]
        ELSE 
             /\ Replicate(i, <<>>, ValueEntry)
